# MicroX environment contract (EP-01 scaffolding).
# Copy to `.env.local` and fill in. NEVER commit real secrets (SEC-008).
# Real connections are wired in their own epics — these are placeholders.

# --- Supabase (EP-02) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (Supabase -> Project Settings -> Database). Used for
# server-side SQL (src/data/pool.ts) and migrations (npm run db:migrate).
DATABASE_URL=
# Only set in CI/local to run the DB integration tests against a throwaway database.
TEST_DATABASE_URL=

# --- OpenRouter (EP-06) — key is stored encrypted in the DB via Settings, not here ---
# The model id and key are managed from the Settings screen (rule 00 / D-02),
# never hard-coded. This var only exists for a local connection smoke test.
OPENROUTER_API_KEY=

# --- Server-side encryption key for secrets at rest (SEC-002) ---
APP_ENCRYPTION_KEY=

# --- Feature flags (EP-01/23) — comma-separated list of enabled flag keys ---
# Gradual rollout: market_analysis, program_generator, question_bank, word_export,
# compliance_engine, quality_engine, center_feedback, versioning, dashboard, export_package
# Example: NEXT_PUBLIC_FEATURE_FLAGS=market_analysis,question_bank
NEXT_PUBLIC_FEATURE_FLAGS=

# --- Edge access control (EP-23 / D-07 / SEC-005) — first line of defense (no login) ---
# IP allow-list: comma-separated IPv4 addresses or CIDR ranges (Deanship network).
# When empty the gate is OFF (dev/local). PRODUCTION MUST SET THIS (owner-supplied range).
# Example: IP_ALLOWLIST=10.0.0.0/8,192.168.1.0/24
IP_ALLOWLIST=
# Origin allow-list: comma-separated exact origins (defense in depth).
# Example: ORIGIN_ALLOWLIST=https://microx.kau.edu.sa
ORIGIN_ALLOWLIST=
